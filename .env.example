# ============================================================================
# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas credenciales al repositorio.
# ============================================================================

# URL pública del sitio. Se usa para canonical, hreflang, sitemap y robots.
# En local puedes dejarla como está; en producción pon el dominio real.
NEXT_PUBLIC_SITE_URL=https://jobid.ai

# --- Formulario de contacto -------------------------------------------------
# Sin estas tres variables el formulario NO envía: responde 503 y muestra al
# visitante el correo directo. Es deliberado: preferimos decir la verdad antes
# que fingir un envío que nunca llega.
#
# Consigue la clave en https://resend.com (plan gratuito: 3.000 correos/mes).
RESEND_API_KEY=
# Dirección que recibe las solicitudes.
CONTACT_TO_EMAIL=hola@jobid.ai
# Remitente. El dominio debe estar verificado en Resend.
CONTACT_FROM_EMAIL=web@jobid.ai
